# ====================================================================
# EditorConfig — https://editorconfig.org
# Consistent whitespace across editors.
# ====================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# TypeScript / JavaScript — 4 spaces
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 4

# Data / config files — 2 spaces
[*.{json,yml,yaml}]
indent_size = 2

# Markdown — keep trailing whitespace (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs
[Makefile]
indent_style = tab
