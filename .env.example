# ====================================================================
# 🤖 TON AGENT — Autonomous AI Trading (Web app on Vercel + Agent on Termux/VPS)
# --------------------------------------------------------------------
# This is the SINGLE SOURCE OF TRUTH for configuration.
# Operators: `cp .env.example .env` then fill in the blanks.
# NEVER commit your real .env — it holds a live wallet mnemonic.
# ====================================================================

# ── Safety switch ───────────────────────────────────────────────────
# When true, the agent boots, connects, and observes markets but places
# NO trades. Use this for a safe smoke test before going live.
OBSERVE_ONLY=false

# ── Network ─────────────────────────────────────────────────────────
NETWORK=mainnet
TON_RPC_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=
TONAPI_BASE=https://tonapi.io/v2
TONAPI_KEY=

# ====================================================================
# 💼 WALLET — tiered 3-wallet model (single master mnemonic)
# --------------------------------------------------------------------
# The agent derives THREE sub-wallets (LOW / MID / HIGH) from ONE master
# mnemonic using per-tier derivation indices. The mnemonic NEVER leaves
# the agent host (not logged, not sent to the web app or any LLM).
# Only fund it with capital you can afford to lose entirely.
# ====================================================================

# 24-word master mnemonic from Tonkeeper / MyTonWallet.
WALLET_MASTER_MNEMONIC=

# Wallet contract version + base subwallet id (shared across tiers).
WALLET_VERSION=v5r1
WALLET_SUBWALLET_ID=698983191

# ── Tier toggles ────────────────────────────────────────────────────
# HIGH starts OFF by design — enable only after you accept its downside
# and enough trades have closed (see HIGH_TIER_UNLOCK_MIN_CLOSED_TRADES).
TIER_LOW_ENABLED=true
TIER_MID_ENABLED=true
TIER_HIGH_ENABLED=false

# ── Per-tier derivation indices (which sub-wallet each tier signs with) ─
WALLET_LOW_INDEX=1
WALLET_MID_INDEX=2
WALLET_HIGH_INDEX=3

# ====================================================================
# 🎯 STRATEGY CAPS — per tier
# --------------------------------------------------------------------
# *_MAX_RISK_PCT     — max % of that tier's bankroll to risk per trade
# *_STOP_LOSS_PCT    — hard stop-loss trigger (% down from entry)
# *_TAKE_PROFIT_T1_PCT — first take-profit target (% up from entry)
# ====================================================================

# LOW tier — conservative
LOW_MAX_RISK_PCT=5
LOW_STOP_LOSS_PCT=25
LOW_TAKE_PROFIT_T1_PCT=60

# MID tier — balanced
MID_MAX_RISK_PCT=10
MID_STOP_LOSS_PCT=35
MID_TAKE_PROFIT_T1_PCT=100

# HIGH tier — aggressive (disabled by default)
HIGH_MAX_RISK_PCT=15
HIGH_STOP_LOSS_PCT=50
HIGH_TAKE_PROFIT_T1_PCT=200

# ── Shared strategy defaults ────────────────────────────────────────
MIN_WALLET_BANKROLL_TON=1
DEFAULT_SNIPE_TON=0.5
SLIPPAGE_TOLERANCE=15
PREFERRED_DEX=stonfi

# ====================================================================
# 🛡️  GLOBAL GUARDRAILS (circuit breaker)
# --------------------------------------------------------------------
# Trading halts for the day once realized loss hits MAX_DAILY_LOSS_TON.
# The HIGH tier only unlocks once the agent has closed at least
# HIGH_TIER_UNLOCK_MIN_CLOSED_TRADES trades. LLM calls are rate-limited.
# ====================================================================
MAX_DAILY_LOSS_TON=2
HIGH_TIER_UNLOCK_MIN_CLOSED_TRADES=5
# Caps to keep brain-call API spend bounded (both in-memory, restart-reset).
MAX_LLM_CALLS_PER_HOUR=30
RADAR_LLM_CAP_PER_TICK=3

# ── Watchlist (comma separated jetton masters/symbols) ──────────────
WATCHLIST=

# ====================================================================
# 🌐 WEB APP CONNECTION (Vercel deployment)
# --------------------------------------------------------------------
# Agent runtime POSTS events to PUBLIC_WEBHOOK_URL; the web UI reads them
# back. AGENT_SHARED_SECRET authenticates that channel (rotate if leaked).
# ====================================================================
PUBLIC_WEBHOOK_URL=https://your-vercel-app.vercel.app/api/ingest
AGENT_SHARED_SECRET=change-me-to-32-bytes-of-randomness

# ── Emergency kill-switch (optional) ────────────────────────────────
# The coordinator polls this endpoint every KILL_SWITCH_INTERVAL_MS. It must
# return JSON like {"kill": true, "reason": "..."} to halt all trading.
# SECURITY: AGENT_SHARED_SECRET is sent as the X-Agent-Secret header, so the
# URL MUST be https:// (http:// is allowed only for localhost/127.0.0.1).
# Leave blank to disable the kill-switch entirely.
KILL_SWITCH_URL=
# Poll cadence and the fail-safe grace window. If the endpoint is unreachable
# for KILL_SWITCH_MAX_MISSES consecutive polls, the agent auto-halts trading
# (fail-safe) and auto-resumes when the endpoint is reachable again.
KILL_SWITCH_INTERVAL_MS=30000
KILL_SWITCH_MAX_MISSES=3

# ====================================================================
# 📊 OBSERVABILITY
# --------------------------------------------------------------------
# LOG_FORMAT: `pretty` for human-readable dev logs, `json` for prod.
# HEALTH_PORT: local health server (GET /healthz), bound to 127.0.0.1.
# SENTRY_DSN: optional error reporting.
# ====================================================================
LOG_FORMAT=pretty
HEALTH_PORT=9090
SENTRY_DSN=

# ====================================================================
# 💾 PERSISTENCE
# --------------------------------------------------------------------
# Directory for the SQLite database (positions, trades, agent state).
# In Docker this is a mounted volume so state survives restarts.
# ====================================================================
DATA_DIR=./data

# ── AI providers ────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# Optional Tavily for deep-research web search (used by the ReAct agent).
TAVILY_API_KEY=

# Optional OpenAI/Anthropic for fallback reasoning paths.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Telegram (optional, only if you want push fallback) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Teleton agent (signal listening + group ops) ────────────────────
TELETON_ENABLED=false
TELETON_API_ID=
TELETON_API_HASH=
TELETON_SESSION=
