# ====================================================================
# 🤖 TON AGENT — Autonomous AI Trading (Web app on Vercel + Agent on Termux)
# ====================================================================

# ── Network ─────────────────────────────────────────────────────────
NETWORK=mainnet
TON_RPC_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=
TONAPI_BASE=https://tonapi.io/v2
TONAPI_KEY=

# ── WALLET (the agent signs with this — keep amounts you can lose) ──
# 24-word (or 12-word) mnemonic from Tonkeeper / MyTonWallet.
WALLET_MNEMONIC=
WALLET_VERSION=v5r1
WALLET_SUBWALLET_ID=698983191

# ── Web app connection (Vercel deployment) ──────────────────────────
# Public URL of your Vercel web app.
# Agent runtime POSTS events here; web UI GETs them via signed JWT.
PUBLIC_WEBHOOK_URL=https://your-vercel-app.vercel.app/api/ingest
AGENT_SHARED_SECRET=change-me-to-32-bytes-of-randomness

# ── AI providers ────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# Optional Tavily for deep-research web search (used by the ReAct agent).
TAVILY_API_KEY=

# Optional OpenAI/Anthropic for fallback reasoning paths.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Telegram (optional, only if you want push fallback) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Strategy defaults ───────────────────────────────────────────────
MAX_PORTFOLIO_RISK_PCT=15
MIN_WALLET_BANKROLL_TON=1
DEFAULT_SNIPE_TON=0.5
SLIPPAGE_TOLERANCE=15
STOP_LOSS_PCT=35
TAKE_PROFIT_T1_PCT=100
PREFERRED_DEX=stonfi

# ── Watchlist (comma separated) ─────────────────────────────────────
WATCHLIST=

# ── Teleton agent (signal listening + group ops) ────────────────────
TELETON_ENABLED=false
TELETON_API_ID=
TELETON_API_HASH=
TELETON_SESSION=
