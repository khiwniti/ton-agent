{
  "name": "@ton-agent/agent-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Headless 24/7 THIN TRADING AGENT — runs on Termux or VPS. LangChain ReAct brain, NVIDIA NIM, TON wallet signer, Ston.fi/DeDust router, mempool radar, MCP tools, pushes events to the web app.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "audit": "ts-node src/cli/audit-cli.ts",
    "trade": "ts-node src/cli/manual-trade.ts",
    "wallet": "ts-node src/cli/wallet-info.ts",
    "wallet:bootstrap": "ts-node src/cli/wallet-bootstrap.ts",
    "mcp": "ts-node src/mcp/standalone.ts",
    "plan": "ts-node src/cli/agent-plan.ts",
    "status": "ts-node src/cli/status-cli.ts",
    "test": "bash scripts/run-tests.sh",
    "test:gate": "tsx --test test/coordinator-gate.test.ts",
    "test:guardrails": "tsx --test test/guardrails.test.mts",
    "test:safetycaps": "tsx --test test/safetycaps.test.ts",
    "test:orchestration": "tsx --test test/orchestration-graph.test.ts",
    "test:telegram": "tsx --test test/telegram-approvals.test.ts",
    "test:skills": "tsx --test test/skills.test.ts",
    "test:wallet-bootstrap": "env DATA_DIR=\"$(mktemp -d)\" WALLET_MASTER_MNEMONIC='test test test test test test test test test test test junk' tsx --test test/wallet-bootstrap.test.ts",
    "test:contracts": "tsx --test test/contract.test.ts test/budgeting-wallet.test.ts",
    "build:contract": "acton build",
    "compile:contract": "acton compile contracts/budgeting-wallet.tolk --boc build/contracts/budgeting-wallet.boc"
  },
  "dependencies": {
    "@dedust/sdk": "^0.8.7",
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/exa": "^1.0.2",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.5.0",
    "@langchain/tavily": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@ston-fi/api": "^0.32.0",
    "@ston-fi/sdk": "^2.7.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/sandbox": "^0.42.0",
    "@ton/ton": "^16.3.0",
    "axios": "^1.17.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "exa-js": "^2.17.0",
    "langchain": "^1.5.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "teleton": "^0.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
