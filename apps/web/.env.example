# ─────────────────────────────────────────────────────────────
# apps/web — environment variables
# Copy to `.env.local` for local dev; set the same keys in Vercel.
# ─────────────────────────────────────────────────────────────

# ── App base URL (must match the deployed URL) ──────────────
# Used for: TON Connect manifest URL, TON Connect proof domain
# verification, and deeplink construction. Always include the
# scheme and NO trailing slash.
#   Local dev:   http://localhost:3000
#   Production:  https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── TON Connect (overrides; defaults are sensible) ──────────
# Manifest URL — defaults to ${NEXT_PUBLIC_APP_URL}/tonconnect-manifest.json
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=
# Bridge URL — defaults to https://bridge.tonapi.io/bridge
NEXT_PUBLIC_TON_BRIDGE_URL=

# ── TONAPI (read-only wallet portfolio fetches) ─────────────
# Optional. Leave blank to use the rate-limited public endpoint.
# (Browser passes Authorization header inline.)
NEXT_PUBLIC_TONAPI_BASE=https://tonapi.io/v2
NEXT_PUBLIC_TONAPI_KEY=

# ── Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ── Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase service-role key (SERVER ONLY — never expose to the browser).
# Used by the /api/ingest webhook + /api/kill to bypass RLS for writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Shared secret the agent sends as `X-Agent-Secret` on webhook POSTs.
# Must match the value configured in apps/agent. Use a long random string.
AGENT_SHARED_SECRET=change-me-to-a-long-random-string

# ── Auth — wallet OR break-glass password ──────────────────
# ADMIN_PASSWORD gates the legacy HMAC cookie login. Leave blank to
# disable password login entirely (recommended for production).
ADMIN_PASSWORD=

# ADMIN_WALLET_ADDRESS gates TON Connect proof-of-ownership login.
# Only the wallet matching this address (case-insensitive comparison
# after EQ->non-bounceable normalisation) can sign in via wallet.
# Set to your own Tonkeeper / OpenMask address.
ADMIN_WALLET_ADDRESS=

# ENABLE_PASSWORD_LOGIN — emergency break-glass. Set to "true" only
# when you need to recover access without the wallet (lost phone etc).
# Default: disabled.
ENABLE_PASSWORD_LOGIN=false
