{
  "name": "ton-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TON Autonomous Trading Agent — owned web app (Vercel) + agent runtime (Termux) monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:agent": "npm --workspace apps/agent run dev",
    "build": "npm run build --workspaces --if-present",
    "deploy:web": "npm --workspace apps/web run deploy",
    "lint": "echo 'no lint configured'"
  },
  "keywords": ["ton", "ai", "agent", "trading", "langchain", "vercel", "nextjs", "monorepo"],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "onnxruntime-node": "npm:noop@1.0.0"
  }
}
